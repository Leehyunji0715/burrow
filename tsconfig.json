{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    },

    // TODO: noUncheckedIndexedAccess 는 기존 코드(ChatMain 날짜 그룹핑)에서
    // 에러 11건이 나므로 보류했다. 메시지를 DB 로 이관해 해당 로직을
    // 재작성할 때 함께 켠다.
    // "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Vite takes care of building everything, not tsc.
    "noEmit": true
  }
}
