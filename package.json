{
  "name": "team-manage-service-remix",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/themes": "3.3.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@vanilla-extract/css": "^1.21.3",
    "dompurify": "^3.2.5",
    "isbot": "^4.1.0",
    "quill": "^2.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.5.0",
    "react-router": "8.4.0",
    "remix-utils": "10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@react-router/dev": "8.4.0",
    "@react-router/fs-routes": "8.4.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "3.9.10",
    "prisma": "^6.9.0",
    "typescript": "^5.1.6",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
